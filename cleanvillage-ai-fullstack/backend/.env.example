# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/cleanvillage_ai

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ESP32 / IoT device ingest key (simple shared-secret auth for sensor devices)
DEVICE_API_KEY=change_this_device_key

# Seed
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OFFICER_PASSWORD=Officer@12345
SEED_WORKER_PASSWORD=Worker@12345
